name: Build ComePany MAX Android APK

on:
  workflow_dispatch:
  push:
    branches:
      - main
      - master

permissions:
  contents: read

jobs:
  build:
    name: Build MAX Debug APK
    runs-on: ubuntu-latest
    timeout-minutes: 45

    steps:

      # ============================================================
      # 1. CHECKOUT REPOSITORY
      # ============================================================

      - name: Checkout repository
        uses: actions/checkout@v4


      # ============================================================
      # 2. SET UP JAVA 17
      # ============================================================

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"


      # ============================================================
      # 3. SET UP ANDROID SDK
      # ============================================================

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3


      # ============================================================
      # 4. ACCEPT ANDROID LICENSES
      # ============================================================

      - name: Accept Android SDK licenses
        shell: bash
        run: |
          yes | sdkmanager --licenses >/dev/null || true


      # ============================================================
      # 5. INSTALL REQUIRED ANDROID SDK
      # ============================================================

      - name: Install Android SDK packages
        shell: bash
        run: |
          set -euo pipefail

          sdkmanager \
            "platform-tools" \
            "platforms;android-36" \
            "build-tools;36.0.0"


      # ============================================================
      # 6. SET UP GRADLE CACHE
      # ============================================================

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4


      # ============================================================
      # 7. FIND THE ANDROID PROJECT
      # ============================================================

      - name: Locate MAX Android project
        shell: bash
        run: |
          set -euo pipefail

          echo "========================================"
          echo " LOCATING COMEPANY MAX ANDROID PROJECT"
          echo "========================================"

          PROJECT_DIR=""

          if [ -f "./settings.gradle" ] || \
             [ -f "./settings.gradle.kts" ]; then

            PROJECT_DIR="."

          else

            SETTINGS_FILE="$(find . \
              -type f \
              -name "settings.gradle" -o -name "settings.gradle.kts" \
              -not -path "*/.git/*" \
              | head -n 1 || true)"

            if [ -n "$SETTINGS_FILE" ]; then
              PROJECT_DIR="$(dirname "$SETTINGS_FILE")"
            fi

          fi

          if [ -z "$PROJECT_DIR" ]; then
            echo ""
            echo "ERROR:"
            echo "Could not find settings.gradle or settings.gradle.kts."
            echo ""
            echo "Repository contents:"
            find . -maxdepth 3 -type f -print
            exit 1
          fi

          PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd)"

          echo ""
          echo "MAX Android project:"
          echo "$PROJECT_DIR"

          echo "PROJECT_DIR=$PROJECT_DIR" >> "$GITHUB_ENV"


      #
